{
    "name": "reactjs-boilerplate",
    "version": "1.1.0",
    "private": true,
    "scripts": {
        "dev": "next dev --turbopack -p 3002",
        "build": "next build",
        "build:e2e": "cp -n example.env.local .env.local && next build",
        "start": "next start",
        "lint": "next lint",
        "prepare": "is-ci || husky",
        "release": "release-it",
        "generate:resource": "hygen generate resource",
        "postgenerate:resource": "npm run lint -- --fix",
        "generate:field": "hygen generate field",
        "postgenerate:field": "npm run lint -- --fix",
        "sb": "storybook dev -p 6006",
        "build-storybook": "storybook build",
        "run-mock-server": "tsx ./mock-server.ts"
    },
    "dependencies": {
        "@emotion/react": "^11.11.1",
        "@emotion/styled": "^11.11.0",
        "@faker-js/faker": "^9.0.0",
        "@fontsource/roboto": "^5.0.8",
        "@hookform/resolvers": "^3.2.0",
        "@mswjs/data": "^0.16.2",
        "@mswjs/http-middleware": "^0.10.3",
        "@mui/icons-material": "6.4.0",
        "@mui/material": "6.4.0",
        "@mui/x-date-pickers": "7.24.0",
        "@react-oauth/google": "^0.12.0",
        "@react-spring/parallax": "^9.7.5",
        "@react-three/drei": "^10.0.7",
        "@react-three/fiber": "^9.1.2",
        "@tanstack/react-query": "^5.0.0",
        "@tanstack/react-query-devtools": "^5.0.0",
        "@testing-library/react": "^16.3.0",
        "@types/jsonwebtoken": "^9.0.9",
        "@types/react": "19.0.7",
        "@types/react-dom": "19.0.3",
        "@types/three": "^0.175.0",
        "accept-language": "^3.0.18",
        "cors": "^2.8.5",
        "date-fns": "^3.6.0",
        "dotenv": "^16.5.0",
        "drei": "^2.2.21",
        "eslint": "8.57.1",
        "eslint-config-next": "15.2.1",
        "express": "^5.1.0",
        "i18next": "24.2.1",
        "i18next-browser-languagedetector": "^8.0.0",
        "i18next-resources-to-backend": "^1.1.4",
        "imap": "^0.8.19",
        "js-cookie": "^3.0.5",
        "jsonwebtoken": "^9.0.2",
        "mailparser": "^3.7.0",
        "msw": "^2.7.5",
        "mui-tiptap": "^1.17.0",
        "nanoid": "^5.0.1",
        "next": "15.2.1",
        "ol": "^10.5.0",
        "ol-ext": "^4.0.31",
        "pino-http": "^10.4.0",
        "r3f": "^1.0.0",
        "react": "^19.0.0",
        "react-dom": "19.0.0",
        "react-dropzone": "^14.2.3",
        "react-hook-form": "^7.45.4",
        "react-i18next": "^15.0.0",
        "react-scroll-parallax": "^3.4.5",
        "react-toastify": "^11.0.2",
        "react-virtuoso": "4.12.3",
        "three": "^0.175.0",
        "tsx": "^4.19.3",
        "typescript": "5.8.2",
        "yup": "^1.2.0"
    },
    "devDependencies": {
        "@chromatic-com/storybook": "^3.0.0",
        "@commitlint/cli": "^19.0.0",
        "@commitlint/config-conventional": "^19.0.0",
        "@playwright/test": "^1.43.1",
        "@release-it/conventional-changelog": "^8.0.1",
        "@storybook/addon-essentials": "^8.1.10",
        "@storybook/addon-interactions": "^8.1.10",
        "@storybook/addon-links": "^8.1.10",
        "@storybook/addon-onboarding": "^8.1.10",
        "@storybook/blocks": "^8.1.10",
        "@storybook/nextjs": "^8.1.10",
        "@storybook/react": "^8.1.10",
        "@storybook/test": "^8.1.10",
        "@types/imap": "^0.8.40",
        "@types/js-cookie": "^3.0.3",
        "@types/mailparser": "^3.4.4",
        "@types/node": "^22.15.3",
        "@types/ol": "^6.5.3",
        "@typescript-eslint/eslint-plugin": "^7.0.0",
        "@typescript-eslint/parser": "^7.0.0",
        "eslint-config-prettier": "^9.1.0",
        "eslint-plugin-prettier": "^5.1.2",
        "eslint-plugin-storybook": "^0.11.0",
        "husky": "^9.0.10",
        "hygen": "^6.2.11",
        "is-ci": "^4.0.0",
        "pino-pretty": "^13.0.0",
        "prettier": "^3.2.5",
        "release-it": "^17.1.1",
        "storybook": "^8.1.10"
    },
    "release-it": {
        "git": {
            "commitMessage": "chore: release v${version}"
        },
        "github": {
            "release": true
        },
        "npm": {
            "publish": false
        },
        "plugins": {
            "@release-it/conventional-changelog": {
                "infile": "CHANGELOG.md",
                "preset": {
                    "name": "conventionalcommits",
                    "types": [
                        {
                            "type": "feat",
                            "section": "Features"
                        },
                        {
                            "type": "fix",
                            "section": "Bug Fixes"
                        },
                        {
                            "type": "perf",
                            "section": "Performance Improvements"
                        },
                        {
                            "type": "revert",
                            "section": "Reverts"
                        },
                        {
                            "type": "docs",
                            "section": "Documentation"
                        },
                        {
                            "type": "refactor",
                            "section": "Code Refactoring"
                        },
                        {
                            "type": "test",
                            "section": "Tests"
                        },
                        {
                            "type": "ci",
                            "section": "Continuous Integration"
                        }
                    ]
                }
            }
        }
    },
    "overrides": {
        "@types/react": "19.0.7",
        "@types/react-dom": "19.0.3"
    }
}
